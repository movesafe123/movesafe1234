# ====================================================================
# MoveSafe VN - Cấu hình Biến Môi trường (Environment Variables)
# ====================================================================

# Cổng khởi chạy HTTP server Node.js
PORT=3000

# API Keys cho dịch vụ ngoài (Tùy chọn nếu muốn dùng key riêng)
OPENWEATHER_KEY=your_openweather_api_key_here
TOMTOM_KEY=your_tomtom_api_key_here
GEMINI_KEY=your_gemini_api_key_here

# Chế độ biểu diễn kịch bản mưa ngập đô thị (Presentation / Demo)
# Đặt true để bot tự động tính toán các điểm ngập đô thị ngay cả khi trời tạnh
DEMO_FLOOD=false

# Supabase Cloud Database (PostgreSQL + PostGIS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
